{
  "name": "kidsteam-conversation-agent",
  "version": "1.0.0",
  "description": "A conversational AI system for children to interact with superhero character Zip",
  "private": true,
  "scripts": {
    "install-all": "npm install && cd react_webapp && npm install && cd ../node_server && npm install",
    "start": "concurrently \"npm run start:server\" \"npm run start:client\"",
    "start:server": "cd node_server && npm run dev",
    "start:client": "cd react_webapp && npm start",
    "build": "cd react_webapp && npm run build",
    "test": "cd react_webapp && npm test",
    "clean": "rm -rf node_modules react_webapp/node_modules node_server/node_modules",
    "fresh-install": "npm run clean && npm run install-all"
  },
  "keywords": ["conversational-ai", "education", "children", "speech-recognition", "react", "nodejs"],
  "author": "KidsTeam",
  "license": "MIT",
  "dependencies": {
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "nodemon": "^2.0.19",
    "concurrently": "^7.6.0"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DrustZ/KidsteamConversationAgent.git"
  }
}
